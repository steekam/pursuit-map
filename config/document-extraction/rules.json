{
  "rule_version": "document-rules-1",
  "normalization_version": "document-normalization-1",
  "description": "Deterministic procurement document feature rules.",
  "rule_defaults": {
    "source_sections": [],
    "table_headers": [],
    "parser": "context_line",
    "normalization": "text",
    "supported_document_roles": ["*"]
  },
  "rules": [
    {"feature_key": "document_role", "family": "identity", "value_type": "text", "patterns": ["tender notice", "technical proposal", "financial proposal", "addendum", "request for proposal", "registration of suppliers", "tender document"]},
    {"feature_key": "document_title", "family": "identity", "value_type": "text", "patterns": ["title", "tender for", "request for proposal"]},
    {"feature_key": "tender_number", "family": "identity", "value_type": "identifier", "patterns": ["tender no", "tender number", "ref. no", "reference no"]},
    {"feature_key": "project_name", "family": "identity", "value_type": "text", "patterns": ["proposed phase", "project title", "development and management"]},
    {"feature_key": "buyer_name", "family": "identity", "value_type": "entity", "patterns": ["republic of kenya", "county government", "ministry", "authority", "institute", "fund", "school"]},
    {"feature_key": "buyer_contact", "family": "identity", "value_type": "text", "patterns": ["contact", "telephone", "email", "address"]},
    {"feature_key": "consultant_name", "family": "identity", "value_type": "entity", "patterns": ["architect", "quantity surveyor", "consultant", "project manager"]},
    {"feature_key": "submission_deadline", "family": "timing", "value_type": "datetime", "patterns": ["submission date", "closing date", "closing date and time", "deadline"]},
    {"feature_key": "opening_date", "family": "timing", "value_type": "datetime", "patterns": ["opening date", "tender opening", "opening time"]},
    {"feature_key": "validity_period_days", "family": "timing", "value_type": "integer", "patterns": ["validity", "valid for"]},
    {"feature_key": "addendum_date", "family": "timing", "value_type": "datetime", "patterns": ["addendum", "clarification", "correction"]},
    {"feature_key": "site_visit_date", "family": "timing", "value_type": "datetime", "patterns": ["site visit", "pre-tender site visit", "mandatory site visit"]},
    {"feature_key": "lot_number", "family": "procurement_structure", "value_type": "identifier", "patterns": ["lot no", "lot number", "item no"]},
    {"feature_key": "lot_description", "family": "procurement_structure", "value_type": "text", "patterns": ["tender description", "lot description"]},
    {"feature_key": "framework_term", "family": "procurement_structure", "value_type": "text", "patterns": ["framework agreement", "two-year framework", "financial years"]},
    {"feature_key": "financial_year", "family": "procurement_structure", "value_type": "text", "patterns": ["financial year", "2026-2027"]},
    {"feature_key": "procurement_method", "family": "procurement_structure", "value_type": "text", "patterns": ["open tender", "open competitive", "international competitive bidding", "request for proposal"]},
    {"feature_key": "eligibility_requirement", "family": "eligibility", "value_type": "text", "patterns": ["eligible tenderers", "eligible bidders", "eligibility", "registered", "registration"]},
    {"feature_key": "required_registration", "family": "eligibility", "value_type": "text", "patterns": ["nca category", "registered contractors", "registration with", "license", "accreditation"]},
    {"feature_key": "required_experience", "family": "eligibility", "value_type": "text", "patterns": ["previous experience", "similar experience", "relevant experience"]},
    {"feature_key": "required_certification", "family": "eligibility", "value_type": "text", "patterns": ["certificate of", "certification", "tax compliance certificate"]},
    {"feature_key": "agpo_category", "family": "eligibility", "value_type": "text", "patterns": ["agpo", "preferred category"]},
    {"feature_key": "mandatory_site_visit", "family": "eligibility", "value_type": "boolean", "patterns": ["mandatory pre-tender site visit", "mandatory site visit"]},
    {"feature_key": "specification", "family": "technical", "value_type": "text", "patterns": ["technical specification", "technical specifications", "specification"]},
    {"feature_key": "quantity", "family": "technical", "value_type": "number", "patterns": ["quantity", "qty"]},
    {"feature_key": "unit", "family": "technical", "value_type": "text", "patterns": ["unit", "units"]},
    {"feature_key": "delivery_location", "family": "technical", "value_type": "text", "patterns": ["delivery location", "place of delivery", "delivery site"]},
    {"feature_key": "warranty_period", "family": "technical", "value_type": "text", "patterns": ["warranty", "guarantee"]},
    {"feature_key": "tender_fee", "family": "commercial", "value_type": "amount", "patterns": ["tender fee", "non-refundable fee"]},
    {"feature_key": "bid_security_amount", "family": "commercial", "value_type": "amount", "patterns": ["bid security", "tender security"]},
    {"feature_key": "bid_security_type", "family": "commercial", "value_type": "text", "patterns": ["bank guarantee", "bid security in the form"]},
    {"feature_key": "currency", "family": "commercial", "value_type": "currency", "patterns": ["kenya shillings", "kes", "usd", "currency"]},
    {"feature_key": "payment_terms", "family": "commercial", "value_type": "text", "patterns": ["payment terms", "payment schedule", "method of payment"]},
    {"feature_key": "price_validity_days", "family": "commercial", "value_type": "integer", "patterns": ["remain valid", "price validity"]},
    {"feature_key": "evaluation_criteria", "family": "evaluation", "value_type": "text", "patterns": ["evaluation criteria", "evaluation will be", "technical evaluation", "financial evaluation"]},
    {"feature_key": "technical_threshold", "family": "evaluation", "value_type": "number", "patterns": ["technical score", "pass mark", "threshold"]},
    {"feature_key": "financial_evaluation", "family": "evaluation", "value_type": "text", "patterns": ["financial proposal", "financial evaluation", "evaluated price"]},
    {"feature_key": "ict_term", "family": "ict", "value_type": "keyword", "patterns": ["ict", "information technology", "information and communication technology"]},
    {"feature_key": "network_term", "family": "ict", "value_type": "keyword", "patterns": ["network", "networking", "router", "switch", "firewall"]},
    {"feature_key": "cybersecurity_term", "family": "ict", "value_type": "keyword", "patterns": ["cybersecurity", "cyber security", "security operations", "vulnerability"]},
    {"feature_key": "software_term", "family": "ict", "value_type": "keyword", "patterns": ["software", "application", "system"]},
    {"feature_key": "cloud_term", "family": "ict", "value_type": "keyword", "patterns": ["cloud", "hosting", "data centre", "datacenter"]},
    {"feature_key": "hardware_term", "family": "ict", "value_type": "keyword", "patterns": ["server", "computer", "laptop", "printer", "hardware"]}
  ]
}
